# Directory paths
WATCH_DIR=D:\iCloudDrive\voice notes
OBSIDIAN_VAULT=D:\iCloudDrive\iCloud~md~obsidian\Mind Castle

# Database & ChromaDB storage
DB_PATH = C:\tools\whisper-watcher\db\voice_notes.db
CHROMA_PATH = C:\tools\whisper-watcher\db\chrome_db

# Whisper settings
WHISPER_EXE=C:\Tools\whisper.cpp-gpu\whisper-cli.exe
WHISPER_MODEL=C:\Tools\whisper.cpp\models\ggml-medium.en.bin
WHISPER_LANG=en

# Ollama settings
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_EMBED_URL=http://localhost:11434/api/embeddings
OLLAMA_MODEL=gemma4
EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT=60

# RAG parameters
RAG_TOP_K=3
RAG_MAX_DISTANCE=0.60

# Note Naming & Formatting (Tokens: {date}, {time}, {category}, {title})
NOTE_NAME_FORMAT={date} {time} - {title}
DATE_FORMAT=%Y-%m-%d
TIME_FORMAT=%H%M
